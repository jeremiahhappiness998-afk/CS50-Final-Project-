{
    "manifest_version": 3,
    "name": "HGJ AD-BLOCKER PRO",
    "version": "2.0",
    "description": "HGJ AD-BLOCKER PRO is a chrome extension for blocking unwanted ADS and popups that disrupt your work online",
    "permissions": [
        "webRequest",
        "activeTab",
        "declarativeNetRequest",
        "contextMenus",
        "tabs",
        "alarms"
    ],
    "icons": {
        "16": "icons/icon_16.png",
        "32": "icons/icon_32.png",
        "48": "icons/icon_48.png",
        "128": "icons/icon_128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon_16.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}